{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Curated hosted surface for stakeholder acceptance analysis. Operator-local configuration remains broader.",
  "properties": {
    "brand_slug": {
      "description": "Brand overlay for rendering. Derived from the run owner; an operator may override.",
      "type": "string",
      "x-pinned": null,
      "x-tier": 3
    },
    "decision_summary": {
      "description": "The decision, proposal, or change whose stakeholder acceptance should be analysed.",
      "minLength": 1,
      "type": "string",
      "x-ask": "What decision or proposed change should the stakeholder analysis assess?",
      "x-tier": 1
    },
    "deliverable_author_max_tokens": {
      "type": "integer",
      "x-pinned": 16000,
      "x-tier": 3
    },
    "deliverable_formats": {
      "default": [
        "pdf-hd"
      ],
      "items": {
        "enum": [
          "pdf",
          "pdf-hd",
          "pptx",
          "pptx-hd",
          "html-deck"
        ],
        "type": "string"
      },
      "type": "array",
      "x-tier": 2
    },
    "deliverable_renderer": {
      "type": "string",
      "x-pinned": "direct",
      "x-tier": 3
    },
    "input_set": {
      "description": "Optional finalized input-set handle (inputset:<uuid>) from create_input_session/finalize_input_session. The runner rehydrates the uploaded documents into the run's raw-inputs folder, where document loading picks them up alongside anything orchestrated sourcing gathers. Tier 2, with no default: absent simply means no client-supplied documents.",
      "pattern": "^inputset:[0-9a-f-]+$",
      "type": "string",
      "x-tier": 2
    },
    "report_output_formats": {
      "default": [
        "html",
        "pdf"
      ],
      "items": {
        "enum": [
          "html",
          "pdf"
        ],
        "type": "string"
      },
      "type": "array",
      "x-tier": 2
    },
    "report_title": {
      "default": "Stakeholder Acceptance Analysis",
      "description": "Optional report title override.",
      "type": "string",
      "x-tier": 2
    },
    "run_chunker": {
      "type": "boolean",
      "x-pinned": true,
      "x-tier": 3
    },
    "run_deep_research": {
      "type": "boolean",
      "x-pinned": true,
      "x-tier": 3
    },
    "run_deliverable_generation": {
      "type": "boolean",
      "x-pinned": true,
      "x-tier": 3
    },
    "run_document_loading": {
      "type": "boolean",
      "x-pinned": true,
      "x-tier": 3
    },
    "run_orchestrated_sourcing": {
      "type": "boolean",
      "x-pinned": true,
      "x-tier": 3
    },
    "run_probability_estimator": {
      "type": "boolean",
      "x-pinned": true,
      "x-tier": 3
    },
    "run_questionnaire_generator": {
      "type": "boolean",
      "x-pinned": true,
      "x-tier": 3
    },
    "run_relevance_filter": {
      "type": "boolean",
      "x-pinned": true,
      "x-tier": 3
    },
    "run_report_generation": {
      "type": "boolean",
      "x-pinned": true,
      "x-tier": 3
    },
    "run_report_precompute": {
      "type": "boolean",
      "x-pinned": true,
      "x-tier": 3
    },
    "run_report_rendering": {
      "type": "boolean",
      "x-pinned": true,
      "x-tier": 3
    },
    "run_review_questionnaire": {
      "type": "boolean",
      "x-pinned": true,
      "x-tier": 3
    },
    "run_scoring": {
      "type": "boolean",
      "x-pinned": true,
      "x-tier": 3
    }
  },
  "workflow": "stakeholder_analysis_workflow",
  "x-artifact-adapter": "stakeholder_exports",
  "x-credential-requirements": {
    "credentials": [],
    "model_registry_digest": "sha256:56a2ba2bb579d99f6a5ea71bdb47e21fa2ac98afd665d689c7ac98ac16461f6b",
    "models": [
      {
        "tier": "cheap"
      },
      {
        "tier": "medium"
      },
      {
        "capabilities": [
          "native_web_search"
        ],
        "tier": "medium"
      },
      {
        "tier": "smart"
      },
      {
        "capabilities": [
          "native_web_search"
        ],
        "tier": "smart"
      }
    ],
    "resolved_credentials": [
      "deepseek-api",
      "openai-api"
    ]
  },
  "x-input-adapter": "inputset"
}
